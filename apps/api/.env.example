# Copy to .env and adjust. The API refuses to boot with invalid config (core/config/env.ts).
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://sprintgo:sprintgo@localhost:5432/sprintgo?schema=public

# Secrets — MUST be replaced in production (32+ chars)
JWT_SECRET=dev-only-jwt-secret-change-in-production-0001
COOKIE_SECRET=dev-only-cookie-secret-change-in-prod-0001
OTP_PEPPER=dev-only-otp-pepper-0001

# Token lifetimes
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=90

# Web Push (optional) — generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave empty to disable push. Never commit real keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@sprintgo.app
